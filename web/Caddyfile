# Caddy config inside the "task-manager" container. Plain HTTP on 8085;
# the host's Caddy terminates HTTPS for tasks.nizamrazak.tech and proxies here.
:8085 {
	root * /srv
	encode gzip

	# Always re-check the page and service worker so updates show straight away.
	@fresh path / /index.html /sw.js /manifest.webmanifest
	header @fresh Cache-Control "no-cache"
	header /manifest.webmanifest Content-Type "application/manifest+json"
	header /icons/* Cache-Control "public, max-age=604800"

	file_server
}
